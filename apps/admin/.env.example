# Admin Panel — Vite Environment Variables
# Copy this file to .env and fill in the values

# API key from api_clients table (run the seeder to get this)
VITE_API_KEY=your_admin_api_key_here

# API base URL (Vite proxy forwards /api → this URL in dev, so leave as-is)
# VITE_API_URL=http://localhost:4000
